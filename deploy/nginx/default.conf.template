# Rendered twice: @IGNIS_API_ORIGIN@ at image build (deploy/build-env.mjs) and
# ${PORT} at container start (nginx image envsubst; Railway injects PORT).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    absolute_redirect off;

    # Applied to every response, including errors (always). Locations below use
    # `expires` rather than add_header so these are inherited, not replaced.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Inline styles: React style props and Leaflet. No inline scripts: Vite emits modules.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://picsum.photos https://fastly.picsum.photos; connect-src 'self' @IGNIS_API_ORIGIN@; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Railway healthcheck: answers without touching disk or the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        expires -1;
        return 200 "ok\n";
    }

    # Vite fingerprints everything under /assets: safe to cache for a year.
    # A missing asset is a 404, never the HTML shell served as JavaScript.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA fallback: any other path renders the app shell and the client router
    # decides (including its own not-found page). The shell is always revalidated
    # so a deploy is picked up on the next navigation.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
